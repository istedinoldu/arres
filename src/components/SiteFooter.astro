            "Yakacık Çarşı Mah. Kartal Cad. Kastelli Sanayi Sitesi C Blok No:64 İç Kapı No:59 Kartal / İstanbul",
        phone: "+90 532 785 05 76",
        email: "info@arres.com.tr",
        copyright:
            "© 2026 Arres Mühendislik Makine İmalat İthalat İhracat Sanayi Ticaret Limited Şirketi. All rights reserved.",
    },
    ru: {
        groupsTitle: "НАПРАВЛЕНИЯ РАБОТЫ",
        quickTitle: "НАВИГАЦИЯ",
        contactTitle: "КОНТАКТНАЯ ИНФОРМАЦИЯ",
        home: "Главная",
        news: "Новости",
