---
import { Image } from "astro:assets";
import arresLogo from "../assets/logo.png";
import ihibLogo from "../assets/ihib.png";
import { LOCALES, UI_STRINGS, type Locale } from "../i18n/ui";

interface Props {
    lang: Locale;
    currentPath?: string;
}

const { lang, currentPath = "" } = Astro.props;
const t = UI_STRINGS[lang];
const prefix = lang === "tr" ? "" : `/${lang}`;
const isRtl = lang === "ar" || lang === "fa";

const getLocaleHref = (targetLocale: Locale) => {
    const cleanPath = currentPath.replace(/^\/+/, "");
    if (targetLocale === "tr") {
        return cleanPath ? `/${cleanPath}` : "/";
    }
    return cleanPath ? `/${targetLocale}/${cleanPath}` : `/${targetLocale}`;
};

const QUICK_LINKS: Record<
    Locale,
    {
        groupsTitle: string;
        quickTitle: string;
        contactTitle: string;
        home: string;
        news: string;
        contact: string;
        description: string;
        ihibBadge: string;
        expoBadge: string;
        companyName: string;
        address: string;
        phone: string;
        email: string;
        copyright: string;
    }
> = {
    tr: {
        groupsTitle: "ÇALIŞMA GRUPLARI",
        quickTitle: "HIZLI ERİŞİM",
        contactTitle: "KURUMSAL İLETİŞİM",
        home: "Anasayfa",
        news: "Haberler",
        contact: "İletişim",
        description:
