const labels = QUICK_LINKS[lang];
---

<footer
    dir={isRtl ? "rtl" : "ltr"}
    class="border-t border-slate-800/80 bg-[#050811] text-slate-300"
>
    <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 sm:px-6 lg:px-8">
        <!-- 4 Sütunlu Ana Yapı -->
        <div class="grid grid-cols-1 gap-10 text-start md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
            <!-- 1. Sütun: Arres Logo + Açıklama + İHİB Rozet & Görsel + CFE Rozet -->
            <div class="space-y-4 lg:col-span-4">
                <a href={prefix || "/"} class="inline-block w-48">
                    <Image
                        src={arresLogo}
                        alt="Arres Mühendislik"
                        widths={[240, 480]}
                        sizes="192px"
                        class="h-auto w-full object-contain"
                    />
                </a>

                <p class="max-w-sm text-sm leading-relaxed text-slate-300">
                    {labels.description}
                </p>

                <div class="flex flex-col items-start gap-2.5 pt-1">
                    <span class="inline-flex max-w-sm items-center rounded-md border border-slate-700/90 bg-slate-900/90 px-3 py-1.5 text-xs font-medium leading-snug text-slate-200">
                        {labels.ihibBadge}
                    </span>

                    <!-- İHİB Görseli: Arres logosu ile aynı genişlikte (w-48) -->
                    <div class="w-48 overflow-hidden rounded-lg border border-slate-700/80 bg-white p-2">
                        <Image
                            src={ihibLogo}
                            alt="İstanbul Halı İhracatçıları Birliği (İHİB)"
                            widths={[240, 480]}
                            sizes="192px"
                            class="h-auto w-full object-contain"
                        />
                    </div>

                    <span class="inline-flex items-center rounded-md border border-amber-500/35 bg-amber-500/10 px-3 py-1.5 text-xs font-medium text-amber-300">
                        {labels.expoBadge}
                    </span>
                </div>
            </div>

            <!-- 2. Sütun: Çalışma Grupları -->
            <div class="space-y-3 lg:col-span-3">
                <h3 class="text-xs font-bold tracking-wider uppercase text-amber-400">
                    {labels.groupsTitle}
                </h3>
                <ul class="space-y-2.5 text-sm">
                    {t.groups.map((group) => (
                        <li>
                            <a
                                href={`${prefix}/#${group.id}`}
                                class="text-slate-300 transition-colors hover:text-amber-300"
                            >
                                {group.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- 3. Sütun: Hızlı Erişim + Dil Seçiciler -->
            <div class="space-y-4 lg:col-span-2">
                <h3 class="text-xs font-bold tracking-wider uppercase text-amber-400">
                    {labels.quickTitle}
                </h3>
                <ul class="space-y-2.5 text-sm">
                    <li>
                        <a
                            href={prefix || "/"}
                            class="text-slate-300 transition-colors hover:text-amber-300"
                        >
                            {labels.home}
                        </a>
                    </li>
                    <li>
                        <a
                            href={`${prefix}/news`}
                            class="text-slate-300 transition-colors hover:text-amber-300"
                        >
                            {labels.news}
                        </a>
                    </li>
                    <li>
                        <a
                            href={`${prefix}/contact`}
                            class="text-slate-300 transition-colors hover:text-amber-300"
                        >
                            {labels.contact}
                        </a>
                    </li>
                    <li>
                        <a
                            href={`${prefix}/privacy`}
                            class="text-xs text-slate-300 transition-colors hover:text-amber-300"
                        >
                            {lang === "tr"
                                ? "Gizlilik ve Çerez Politikası"
                                : lang === "en"
                                  ? "Privacy & Cookie Policy"
                                  : lang === "ru"
                                    ? "Политика конфиденциальности и cookie"
                                    : lang === "ar"
                                      ? "سياسة الخصوصية وملفات تعريف الارتباط"
                                      : "سیاست حریم خصوصی و کوکی‌ها"}
                        </a>
                    </li>
                </ul>

                <div class="flex flex-wrap gap-1.5 pt-1">
                    {LOCALES.map((loc) => {
                        const active = loc === lang;
                        return (
                            <a
                                href={getLocaleHref(loc)}
                                class:list={[
                                    "rounded border px-2.5 py-1 text-[11px] font-semibold uppercase transition-colors",
                                    active
                                        ? "border-amber-400/70 bg-amber-500/20 text-amber-300"
                                        : "border-slate-700/80 bg-slate-900/70 text-slate-300 hover:border-slate-500 hover:text-white",
                                ]}
                            >
                                {loc}
                            </a>
                        );
                    })}
                </div>
            </div>

            <!-- 4. Sütun: Kurumsal İletişim -->
            <div class="space-y-3 lg:col-span-3">
                <h3 class="text-xs font-bold tracking-wider uppercase text-amber-400">
                    {labels.contactTitle}
                </h3>
                <p class="text-sm font-bold leading-snug text-white">
                    {labels.companyName}
                </p>
                <p class="text-xs leading-relaxed text-slate-400">
                    {labels.address}
                </p>
                <div class="space-y-1 pt-1 text-sm font-semibold text-amber-400">
                    <div>
                        <a
                            href={`tel:${labels.phone.replace(/\s+/g, "")}`}
                            class="transition-colors hover:text-amber-300"
                        >
                            {labels.phone}
                        </a>
                    </div>
                    <div>
                        <a
                            href={`mailto:${labels.email}`}
                            class="transition-colors hover:text-amber-300"
                        >
                            {labels.email}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alt Telif Satırı -->
        <div class="mt-10 flex flex-col items-start justify-between gap-2 border-t border-slate-800/80 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center">
            <p>{labels.copyright}</p>
            <a
                href="https://arres.com.tr"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 transition-colors hover:text-amber-300"
            >
                arres.com.tr
            </a>
        </div>
    </div>
</footer>
