        description:
            "Tufting carpet machines, quilting systems, custom machinery manufacturing, robotic automation, and CNC machining & overhaul solutions.",
        ihibBadge: "Member of Istanbul Carpet Exporters' Association (İHİB)",
        expoBadge: "CFE 2027 • Hall 2, Booth 205",
        companyName:
