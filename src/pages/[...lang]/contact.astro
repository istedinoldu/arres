---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  CONTACT_INFO,
  CONTACT_UI,
  LOCALES,
  UI_STRINGS,
  type Locale,
} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { lang: locale === "tr" ? undefined : locale },
    props: { lang: locale },
  }));
}

const props = Astro.props as { lang?: Locale };
const lang: Locale = props.lang && props.lang in UI_STRINGS ? props.lang : "tr";
const t = UI_STRINGS[lang];
const c = CONTACT_UI[lang];

const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "";
---

<BaseLayout
  lang={lang}
  title={`${t.nav.contact} — ${t.siteTitle}`}
  description={c.subtitle}
>
  <SiteHeader lang={lang} currentPath="contact" />

  <main class="mx-auto max-w-6xl space-y-10 px-4 py-10">
    <!-- Başlık -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 sm:p-8">
      <h1 class="text-3xl font-bold tracking-tight text-white">
        {t.nav.contact}
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base">
        {c.subtitle}
      </p>
    </section>

    <div class="grid gap-8 lg:grid-cols-12">
      <!-- Sol Kolon: Resmi Unvan, Adres, Telefon, E-posta ve Birimler -->
      <section class="space-y-6 lg:col-span-5">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6">
          <h2 class="text-lg font-bold text-white">{c.detailsHeading}</h2>

          <div class="mt-4 space-y-4 text-sm text-slate-300">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-amber-400">
                {t.siteTitle}
              </p>
              <p class="mt-1 font-medium leading-relaxed text-white">
                {CONTACT_INFO.companyLegalName}
              </p>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                Adres / Address
              </p>
              <p class="mt-1 leading-relaxed text-slate-300">
                {CONTACT_INFO.address}
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-6 border-t border-slate-800 pt-4">
              <div>
                <p class="text-xs text-slate-400">Tel</p>
                <a
                  href={`tel:${CONTACT_INFO.phoneTel}`}
                  dir="ltr"
                  class="mt-0.5 inline-block font-semibold text-amber-400 transition hover:text-amber-300"
                >
                  {CONTACT_INFO.phoneDisplay}
                </a>
              </div>

              <div>
                <p class="text-xs text-slate-400">E-posta / Email</p>
                <a
                  href={`mailto:${CONTACT_INFO.email}`}
                  dir="ltr"
                  class="mt-0.5 inline-block font-semibold text-amber-400 transition hover:text-amber-300"
                >
                  {CONTACT_INFO.email}
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <h2 class="text-lg font-bold text-white">{c.departmentsHeading}</h2>

          <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
            <h3 class="text-sm font-bold text-white">{c.domesticTitle}</h3>
            <p class="mt-1 text-xs text-slate-400">{c.domesticSubtitle}</p>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs">
              <a
                href={`tel:${CONTACT_INFO.phoneTel}`}
                dir="ltr"
                class="font-semibold text-amber-400 hover:text-amber-300"
              >
                {CONTACT_INFO.phoneDisplay}
              </a>
              <a
                href={`mailto:${CONTACT_INFO.email}`}
                dir="ltr"
                class="font-semibold text-amber-400 hover:text-amber-300"
              >
                {CONTACT_INFO.email}
              </a>
            </div>
          </div>

          <div class="rounded-xl border border-amber-500/30 bg-slate-900/70 p-5">
            <h3 class="text-sm font-bold text-amber-300">{c.exportTitle}</h3>
            <p class="mt-1 text-xs text-slate-400">{c.exportSubtitle}</p>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs">
              <a
                href={`tel:${CONTACT_INFO.phoneTel}`}
                dir="ltr"
                class="font-semibold text-amber-400 hover:text-amber-300"
              >
                {CONTACT_INFO.phoneDisplay}
              </a>
              <a
                href={`mailto:${CONTACT_INFO.email}`}
                dir="ltr"
                class="font-semibold text-amber-400 hover:text-amber-300"
              >
                {CONTACT_INFO.email}
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Sağ Kolon: İletişim Formu -->
      <section class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 sm:p-8 lg:col-span-7">
        <h2 class="text-xl font-bold text-white">{c.formHeading}</h2>
        <p class="mt-1.5 text-sm text-slate-300">{c.formSubtitle}</p>

        <form
          id="arres-contact-form"
          data-endpoint={formEndpoint}
          data-lang={lang}
          data-sending={c.sendingButton}
          data-submit={c.submitButton}
          data-success={c.successMessage}
          data-error={c.errorMessage}
          class="mt-6 space-y-5"
        >
          <input type="hidden" name="locale" value={lang} />

          <div>
            <label
              for="contact-name"
              class="block text-sm font-medium text-slate-200"
            >
              {c.nameLabel} *
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              placeholder={c.namePlaceholder}
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-400 focus:outline-none"
            />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label
                for="contact-email"
                class="block text-sm font-medium text-slate-200"
              >
                {c.emailLabel} *
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder={c.emailPlaceholder}
                class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-400 focus:outline-none"
              />
            </div>

            <div>
              <label
                for="contact-phone"
                class="block text-sm font-medium text-slate-200"
              >
                {c.phoneLabel}
              </label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                dir="ltr"
                placeholder={c.phonePlaceholder}
                class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-400 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label
              for="contact-department"
              class="block text-sm font-medium text-slate-200"
            >
              {c.departmentLabel}
            </label>
            <select
              id="contact-department"
              name="department"
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-white focus:border-amber-400 focus:outline-none"
            >
              {c.departments.map((dept) => (
                <option value={dept.value}>{dept.label}</option>
              ))}
            </select>
          </div>

          <div>
            <label
              for="contact-message"
              class="block text-sm font-medium text-slate-200"
            >
              {c.messageLabel} *
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows={5}
              required
              placeholder={c.messagePlaceholder}
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-400 focus:outline-none"
            ></textarea>
          </div>

          <div
            id="contact-status"
            role="status"
            aria-live="polite"
            class="hidden rounded-lg border px-4 py-3 text-sm"
          ></div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="inline-flex items-center justify-center rounded-lg bg-amber-500 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-400 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {c.submitButton}
          </button>
        </form>
      </section>
    </div>
  </main>

  <script>
    const form = document.getElementById(
      "arres-contact-form",
    ) as HTMLFormElement | null;
    const statusBox = document.getElementById(
      "contact-status",
    ) as HTMLDivElement | null;
    const submitBtn = document.getElementById(
      "contact-submit-btn",
    ) as HTMLButtonElement | null;

    if (form && statusBox && submitBtn) {
      const endpoint = form.dataset.endpoint || "";
      const sendingText = form.dataset.sending || "Gönderiliyor...";
      const submitText = form.dataset.submit || "Gönder";
      const successText = form.dataset.success || "Gönderildi.";
      const errorText = form.dataset.error || "Hata oluştu.";

      const showStatus = (message: string, ok: boolean) => {
        statusBox.textContent = message;
        statusBox.classList.remove(
          "hidden",
          "border-emerald-500/40",
          "bg-emerald-500/10",
          "text-emerald-300",
          "border-rose-500/40",
          "bg-rose-500/10",
          "text-rose-300",
        );
        if (ok) {
          statusBox.classList.add(
            "border-emerald-500/40",
            "bg-emerald-500/10",
            "text-emerald-300",
          );
        } else {
          statusBox.classList.add(
            "border-rose-500/40",
            "bg-rose-500/10",
            "text-rose-300",
          );
        }
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        submitBtn.disabled = true;
        submitBtn.textContent = sendingText;

        try {
          const formData = new FormData(form);
          const payload = Object.fromEntries(formData.entries());

          if (!endpoint) {
            showStatus(
              `${successText} (${endpoint || "Form endpoint henüz yapılandırılmadı; doğrudan info@arres.com.tr ile de ulaşabilirsiniz."})`,
              true,
            );
            form.reset();
            return;
          }

          const response = await fetch(endpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }

          showStatus(successText, true);
          form.reset();
        } catch {
          showStatus(errorText, false);
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = submitText;
        }
      });
    }
  </script>
</BaseLayout>
